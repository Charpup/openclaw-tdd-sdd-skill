{
  "contractVersion": "2.0.0",
  "component": "tdd-sdd-development",
  "role": "TDD+SDD dual-pyramid development engine",
  "interface": {
    "reads": {
      "triadev-handoff.json": ["scheduling.batches", "implementation.current"]
    },
    "writes": {
      "triadev-handoff.json": ["implementation.completed", "implementation.spec_path", "implementation.tdd_state_path"]
    },
    "owns": ["SPEC.yaml", ".tdd-state.json"],
    "capabilities": [
      "spec-driven-development",
      "red-green-refactor-cycle",
      "file-based-tdd-evidence",
      "delta-spec-brownfield",
      "coverage-threshold-enforcement"
    ],
    "scripts": {
      "run_tests": "python scripts/run_tests.py",
      "check_coverage": "python scripts/check_coverage.py --threshold 80"
    }
  },
  "dependencies": {
    "planning-with-files": ">=2.10.0"
  }
}
